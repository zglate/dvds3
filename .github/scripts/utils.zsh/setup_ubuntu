autoload -Uz log_error log_status log_info mkcd

if (( ! ${+project_root} )) {
  log_error "'project_root' not set. Please set before running ${0}."
  return 2
}

if (( ! ${+target} )) {
  log_error "'target' not set. Please set before running ${0}."
  return 2
}

pushd ${project_root}

typeset -g QT_VERSION

local -a apt_args=(
  ${CI:+-y}
  --no-install-recommends
)
if (( _loglevel == 0 )) apt_args+=(--quiet)

if (( ! (${skips[(Ie)all]} + ${skips[(Ie)deps]}) )) {
  log_group 'Installing obs-studio build dependencies...'

  local suffix
  if [[ ${CPUTYPE} != "${target##*-}" ]] {
    local -A arch_mappings=(
      aarch64 arm64
      x86_64 amd64
    )

    suffix=":${arch_mappings[${target##*-}]}"

    sudo apt-get install ${apt_args} gcc-${${target##*-}//_/-}-linux-gnu g++-${${target##*-}//_/-}-linux-gnu
  }

  # The GitHub runner image prefers its Azure-internal mirror, which has been
  # observed crawling at a few KB/s for 26.04 packages. Prefer the main archive.
  if [[ -f /etc/apt/apt-mirrors.txt ]] {
    printf 'https://archive.ubuntu.com/ubuntu/\tpriority:1\nhttp://azure.archive.ubuntu.com/ubuntu/\tpriority:2\nhttps://security.ubuntu.com/ubuntu/\tpriority:3\n' \
      | sudo tee /etc/apt/apt-mirrors.txt > /dev/null
  }

  sudo add-apt-repository --yes ppa:obsproject/obs-studio

  # Ubuntu 26.04 images fetch only the archive's amd64v3 package indexes, and
  # the PPA publishes plain amd64 only, so without this apt never sees the
  # PPA's packages and installs the archive's older obs-studio instead.
  local ppa_source
  for ppa_source in /etc/apt/sources.list.d/obsproject-ubuntu-obs-studio-*.sources(N); do
    if ! grep -q '^Architectures:' "${ppa_source}"; then
      echo 'Architectures: amd64' | sudo tee -a "${ppa_source}" > /dev/null
    fi
  done
  sudo apt update

  sudo apt-get install ${apt_args} \
    build-essential \
    libgles2-mesa-dev \
    libsimde-dev \
    obs-studio

  # The plugin is built against whatever libobs the PPA ships. It needs the OBS 33
  # headers (gs_image_file_* was removed in 33), so refuse to build a .so against
  # anything older rather than ship one that will not load.
  local obs_version
  obs_version="$(dpkg-query -W -f='${Version}' obs-studio)"
  if ! dpkg --compare-versions "${obs_version}" ge 33; then
    log_error "obs-studio ${obs_version} from the PPA is older than 33.0.0; cannot build dvds3 against it."
    return 2
  fi
  log_info "Building against obs-studio ${obs_version}"

  local -a _qt_packages=()

  if (( QT_VERSION == 5 )) {
    _qt_packages+=(
      qtbase5-dev${suffix}
      libqt5svg5-dev${suffix}
      qtbase5-private-dev${suffix}
      libqt5x11extras5-dev${suffix}
    )
  } else {
    _qt_packages+=(
      qt6-base-dev${suffix}
      libqt6svg6-dev${suffix}
      qt6-base-private-dev${suffix}
    )
  }

  sudo apt-get install ${apt_args} ${_qt_packages}
  log_group
}
